# =========================
# BudgetPet - Gemini
# =========================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
PORT=3000

# =========================
# BudgetPet - Turso Cloud
# =========================
# Central auth database URL, e.g. https://budgetpet-auth-yourorg.turso.io
TURSO_DATABASE_URL=
# Token scoped to the central auth database
TURSO_AUTH_TOKEN=
# Turso personal account / organization slug
TURSO_ORG=
# Turso group where user databases are provisioned
TURSO_GROUP=default
# Platform API token used ONLY by the server to provision isolated user databases.
# Keep this secret and NEVER commit it to GitHub.
TURSO_PLATFORM_TOKEN=
# Lifetime used for per-user database tokens
TURSO_TOKEN_EXPIRATION=30d

# =========================
# Optional local-only mode
# =========================
# Leave Turso variables empty to use local SQLite under ./database.
# DATA_DIR=./database
