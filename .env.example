# Gemini API key - set this in your hosting provider's secret/environment settings.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
PORT=3000
# Optional custom location for the central auth database.
# AUTH_DB_FILE=database/auth.db

# Optional Gemini model override; current default is gemini-flash-latest.
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
